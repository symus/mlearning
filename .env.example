# PostgreSQL connection string
DATABASE_URL="postgresql://app:app@localhost:5432/arivupulla?schema=public"

# Public base URL of the app. Used inside QR login cards, so a phone must be able to open it.
# To test on a phone/tablet on your Wi-Fi, use your computer's network address,
# e.g. APP_URL="http://192.168.1.25:3000" (the dev server allows this computer's own addresses automatically).
APP_URL="http://localhost:3000"
# Optional: extra hostnames allowed to use the dev server, comma-separated (e.g. "192.168.1.30,my-pc.local")
DEV_ORIGINS=""

# Sessions last this many days
SESSION_TTL_DAYS="30"

# Seed: demo parent account created by `npm run db:seed`
SEED_DEMO_EMAIL="parent@example.com"
SEED_DEMO_PASSWORD="Wonder-demo-2026"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="Wonder-admin-2026"
SEED_TEACHER_EMAIL="teacher@example.com"
SEED_TEACHER_PASSWORD="Teach-demo-2026"
