# PostgreSQL connection string
DATABASE_URL="postgresql://app:app@localhost:5432/wondergrove?schema=public"

# Public base URL of the app (used for links in emails/reports later)
APP_URL="http://localhost:3000"

# Sessions last this many days
SESSION_TTL_DAYS="30"

# Seed: demo parent account created by `npm run db:seed`
SEED_DEMO_EMAIL="parent@example.com"
SEED_DEMO_PASSWORD="Wonder-demo-2026"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="Wonder-admin-2026"
