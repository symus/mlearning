{
  "activities": [
    {
      "slug": "number-bonds-to-10",
      "ageBand": "YOUNG_THINKERS", "subject": "maths", "topic": "Number", "subtopic": "Number bonds",
      "objective": "MA.BONDS.TEN", "title": "Rocket Bonds to 10", "pathOrder": 1, "estimatedMinutes": 5, "isFree": true,
      "learn": {
        "text": "Number bonds are pairs that make a number. On a ten frame, the filled boxes and the empty boxes always make 10 together. 7 filled + 3 empty = 10.",
        "visual": { "kind": "tenFrame", "filled": 7 },
        "example": "7 + 3 = 10, so 3 + 7 = 10 too."
      },
      "misconceptions": [
        { "code": "ADDED_INSTEAD", "description": "Added the given numbers instead of finding the missing part.", "remedy": "We know the total is 10. Find the part that is missing." },
        { "code": "OFF_BY_ONE", "description": "Answer is one away; often from counting the starting number again.", "remedy": "Count the empty boxes in the ten frame." }
      ],
      "mastery": { "minAccuracy": 0.8, "minItems": 5, "atLevel": 2 },
      "followUp": "adding-within-20",
      "levels": [
        { "level": 1, "label": "Warm-up", "items": [
          { "id": "b1", "type": "number", "prompt": "6 + ? = 10", "visual": { "kind": "tenFrame", "filled": 6 }, "answer": 4,
            "hints": ["Count the empty boxes.", "6, then count on to 10: 7, 8, 9, 10."], "explanation": "6 boxes are filled and 4 are empty. 6 + 4 = 10.",
            "misconceptions": { "16": "ADDED_INSTEAD", "3": "OFF_BY_ONE", "5": "OFF_BY_ONE" } },
          { "id": "b2", "type": "number", "prompt": "8 + ? = 10", "visual": { "kind": "tenFrame", "filled": 8 }, "answer": 2,
            "hints": ["How many empty boxes?", "8... 9, 10. That's two jumps."], "explanation": "8 + 2 = 10.",
            "misconceptions": { "18": "ADDED_INSTEAD", "1": "OFF_BY_ONE", "3": "OFF_BY_ONE" } }
        ]},
        { "level": 2, "label": "Explorer", "items": [
          { "id": "b3", "type": "number", "prompt": "? + 3 = 10", "answer": 7,
            "hints": ["What do you add to 3 to make 10?", "Picture a ten frame with 3 filled. How many empty?"], "explanation": "7 + 3 = 10. Bonds work in either order.",
            "misconceptions": { "13": "ADDED_INSTEAD", "6": "OFF_BY_ONE", "8": "OFF_BY_ONE" } },
          { "id": "b4", "type": "choice", "prompt": "Which pair makes 10?",
            "options": [{ "id": "a", "label": "4 and 5" }, { "id": "b", "label": "5 and 5" }, { "id": "c", "label": "6 and 3" }], "answer": "b",
            "hints": ["Add each pair.", "Double 5 is..."], "explanation": "5 + 5 = 10. (4 + 5 = 9 and 6 + 3 = 9.)",
            "misconceptions": { "a": "OFF_BY_ONE", "c": "OFF_BY_ONE" } },
          { "id": "b5", "type": "number", "prompt": "10 − 1 = ?", "answer": 9,
            "hints": ["10 is made of 9 and 1.", "One less than 10."], "explanation": "9 + 1 = 10, so 10 − 1 = 9.",
            "misconceptions": { "11": "ADDED_INSTEAD", "8": "OFF_BY_ONE" } }
        ]},
        { "level": 3, "label": "Challenge", "items": [
          { "id": "b6", "type": "number", "prompt": "Lena needs 10 stickers to fill a page. She has 4. How many more does she need?", "answer": 6,
            "hints": ["4 + ? = 10", "Count on from 4 to 10."], "explanation": "4 + 6 = 10, so she needs 6 more.",
            "misconceptions": { "14": "ADDED_INSTEAD", "5": "OFF_BY_ONE", "7": "OFF_BY_ONE" } },
          { "id": "b7", "type": "number", "prompt": "If 3 + 7 = 10, what is 30 + 70?", "answer": 100,
            "hints": ["3 tens + 7 tens = ? tens", "10 tens is..."], "explanation": "3 tens and 7 tens make 10 tens, which is 100. Bonds to 10 help with bonds to 100!",
            "misconceptions": { "10": "OFF_BY_ONE" } }
        ]}
      ]
    },
    {
      "slug": "adding-within-20",
      "ageBand": "YOUNG_THINKERS", "subject": "maths", "topic": "Number", "subtopic": "Addition",
      "objective": "MA.ADD.WITHIN20", "title": "Bridge Through 10", "pathOrder": 2, "estimatedMinutes": 6,
      "learn": {
        "text": "To add numbers that cross 10, make a 10 first. For 8 + 5: take 2 from the 5 to fill up to 10, then add the 3 left over. 10 + 3 = 13.",
        "visual": { "kind": "numberLine", "from": 0, "to": 20, "mark": 8, "jumps": [10, 13] },
        "example": "8 + 5 = 8 + 2 + 3 = 10 + 3 = 13"
      },
      "misconceptions": [
        { "code": "COUNT_ALL_SLIP", "description": "Answer is one off from counting the starting number as a step.", "remedy": "On a number line, count the jumps, not the starting number." },
        { "code": "DIGIT_CONCAT", "description": "Writes digits side by side (e.g. 1 and 5 makes 15) rather than adding.", "remedy": "Adding means combining amounts. Use a ten frame to check." },
        { "code": "SUBTRACTED", "description": "Subtracted instead of adding.", "remedy": "Look at the sign: + means put together." }
      ],
      "mastery": { "minAccuracy": 0.8, "minItems": 5, "atLevel": 2 },
      "followUp": "subtracting-within-20",
      "levels": [
        { "level": 1, "label": "Warm-up", "items": [
          { "id": "ad1", "type": "number", "prompt": "10 + 4 = ?", "visual": { "kind": "placeValue", "tens": 1, "ones": 4 }, "answer": 14,
            "hints": ["1 ten and 4 ones.", "Teen numbers start with 1 ten."], "explanation": "10 + 4 = 14: one ten and four ones.",
            "misconceptions": { "13": "COUNT_ALL_SLIP", "15": "COUNT_ALL_SLIP", "6": "SUBTRACTED" } },
          { "id": "ad2", "type": "number", "prompt": "7 + 3 = ?", "answer": 10,
            "hints": ["It's a bond to 10!", "7... 8, 9, 10"], "explanation": "7 + 3 = 10.",
            "misconceptions": { "9": "COUNT_ALL_SLIP", "11": "COUNT_ALL_SLIP", "4": "SUBTRACTED" } }
        ]},
        { "level": 2, "label": "Explorer", "items": [
          { "id": "ad3", "type": "number", "prompt": "8 + 5 = ?", "visual": { "kind": "numberLine", "from": 0, "to": 20, "mark": 8 }, "answer": 13,
            "hints": ["Make 10 first: 8 + 2 = 10.", "You still have 3 left from the 5. 10 + 3 = ?"], "explanation": "8 + 2 = 10, then 10 + 3 = 13.",
            "misconceptions": { "12": "COUNT_ALL_SLIP", "14": "COUNT_ALL_SLIP", "3": "SUBTRACTED", "85": "DIGIT_CONCAT" } },
          { "id": "ad4", "type": "number", "prompt": "9 + 6 = ?", "answer": 15,
            "hints": ["9 needs 1 more to make 10.", "10 + 5 = ?"], "explanation": "9 + 1 = 10, then add the other 5: 15.",
            "misconceptions": { "14": "COUNT_ALL_SLIP", "16": "COUNT_ALL_SLIP", "3": "SUBTRACTED" } },
          { "id": "ad5", "type": "number", "prompt": "6 + 7 = ?", "answer": 13,
            "hints": ["Use a double: 6 + 6 = 12.", "One more than 12."], "explanation": "6 + 6 = 12 and 7 is one more than 6, so 6 + 7 = 13.",
            "misconceptions": { "12": "COUNT_ALL_SLIP", "14": "COUNT_ALL_SLIP", "1": "SUBTRACTED" } }
        ]},
        { "level": 3, "label": "Challenge", "items": [
          { "id": "ad6", "type": "number", "prompt": "Tomasz scored 7 goals on Monday and 8 on Tuesday. How many goals altogether?", "answer": 15,
            "hints": ["7 + 8. Make a 10 first.", "7 + 3 = 10, and 5 more is 15."], "explanation": "7 + 8 = 15.",
            "misconceptions": { "14": "COUNT_ALL_SLIP", "16": "COUNT_ALL_SLIP", "1": "SUBTRACTED" } },
          { "id": "ad7", "type": "number", "prompt": "5 + 4 + 5 = ?", "answer": 14,
            "hints": ["Look for a pair that makes 10.", "5 + 5 = 10, then add 4."], "explanation": "Add the 5s first to make 10, then 10 + 4 = 14.",
            "misconceptions": { "13": "COUNT_ALL_SLIP", "15": "COUNT_ALL_SLIP" } }
        ]}
      ]
    },
    {
      "slug": "subtracting-within-20",
      "ageBand": "YOUNG_THINKERS", "subject": "maths", "topic": "Number", "subtopic": "Subtraction",
      "objective": "MA.SUB.WITHIN20", "title": "Moon Jumps Back", "pathOrder": 3, "estimatedMinutes": 6,
      "learn": {
        "text": "Subtraction can mean taking away, or finding the difference. To take away, jump back on a number line. For 14 − 6: jump back 4 to reach 10, then 2 more to reach 8.",
        "visual": { "kind": "numberLine", "from": 0, "to": 20, "mark": 14, "jumps": [10, 8] },
        "example": "14 − 4 = 10, then 10 − 2 = 8"
      },
      "misconceptions": [
        { "code": "SMALLER_FROM_LARGER", "description": "Subtracts the smaller digit from the larger in each place (e.g. 13 − 5 → 12).", "remedy": "You can't take 5 ones from 3 ones. Break a ten: 13 − 3 = 10, then 10 − 2 = 8." },
        { "code": "COUNT_BACK_SLIP", "description": "Answer is one off from counting the starting number as a jump.", "remedy": "Count the jumps back, not the number you start on." },
        { "code": "ADDED", "description": "Added instead of subtracting.", "remedy": "Look at the sign: − means take away." }
      ],
      "mastery": { "minAccuracy": 0.8, "minItems": 5, "atLevel": 2 },
      "followUp": "tens-and-ones",
      "levels": [
        { "level": 1, "label": "Warm-up", "items": [
          { "id": "sb1", "type": "number", "prompt": "9 − 4 = ?", "visual": { "kind": "objects", "emoji": "🍪", "count": 9 }, "answer": 5,
            "hints": ["Imagine eating 4 cookies.", "Count back: 8, 7, 6, 5."], "explanation": "9 − 4 = 5.",
            "misconceptions": { "4": "COUNT_BACK_SLIP", "6": "COUNT_BACK_SLIP", "13": "ADDED" } },
          { "id": "sb2", "type": "number", "prompt": "15 − 5 = ?", "visual": { "kind": "placeValue", "tens": 1, "ones": 5 }, "answer": 10,
            "hints": ["Take away all the ones.", "1 ten and 0 ones."], "explanation": "15 is 10 and 5. Take away 5 and 10 is left.",
            "misconceptions": { "9": "COUNT_BACK_SLIP", "11": "COUNT_BACK_SLIP", "20": "ADDED" } }
        ]},
        { "level": 2, "label": "Explorer", "items": [
          { "id": "sb3", "type": "number", "prompt": "13 − 5 = ?", "visual": { "kind": "numberLine", "from": 0, "to": 20, "mark": 13 }, "answer": 8,
            "hints": ["Jump back 3 to get to 10.", "You need 2 more jumps back from 10."], "explanation": "13 − 3 = 10, then 10 − 2 = 8.",
            "misconceptions": { "12": "SMALLER_FROM_LARGER", "7": "COUNT_BACK_SLIP", "9": "COUNT_BACK_SLIP", "18": "ADDED" } },
          { "id": "sb4", "type": "number", "prompt": "16 − 9 = ?", "answer": 7,
            "hints": ["16 − 6 = 10.", "Then take away 3 more."], "explanation": "16 − 6 = 10 and 10 − 3 = 7.",
            "misconceptions": { "13": "SMALLER_FROM_LARGER", "6": "COUNT_BACK_SLIP", "8": "COUNT_BACK_SLIP", "25": "ADDED" } }
        ]},
        { "level": 3, "label": "Challenge", "items": [
          { "id": "sb5", "type": "number", "prompt": "Amara has 17 marbles. Kai has 9. How many more marbles does Amara have?", "answer": 8,
            "hints": ["'How many more' means find the difference: 17 − 9.", "Count up from 9 to 17."], "explanation": "From 9 to 10 is 1, from 10 to 17 is 7. 1 + 7 = 8.",
            "misconceptions": { "12": "SMALLER_FROM_LARGER", "26": "ADDED", "7": "COUNT_BACK_SLIP", "9": "COUNT_BACK_SLIP" } },
          { "id": "sb6", "type": "number", "prompt": "? − 6 = 8", "answer": 14,
            "hints": ["Subtraction and addition are opposites.", "What is 8 + 6?"], "explanation": "8 + 6 = 14, so 14 − 6 = 8.",
            "misconceptions": { "2": "ADDED", "13": "COUNT_BACK_SLIP", "15": "COUNT_BACK_SLIP" } }
        ]}
      ]
    },
    {
      "slug": "tens-and-ones",
      "ageBand": "YOUNG_THINKERS", "subject": "maths", "topic": "Number", "subtopic": "Place value",
      "objective": "MA.PV.TENSONES", "title": "Tens and Ones", "pathOrder": 4, "estimatedMinutes": 5, "isFree": true,
      "learn": {
        "text": "In a two-digit number, the left digit tells us how many tens and the right digit tells us how many ones. 46 is 4 tens and 6 ones: 40 + 6.",
        "visual": { "kind": "placeValue", "tens": 4, "ones": 6 }
      },
      "misconceptions": [
        { "code": "FACE_VALUE", "description": "Treats the tens digit as its face value (the 4 in 46 means 4, not 40).", "remedy": "The 4 is in the tens place, so it means 4 tens: 40." },
        { "code": "REVERSED_DIGITS", "description": "Swaps tens and ones (writes 64 for 46).", "remedy": "Tens go on the left, ones on the right." }
      ],
      "mastery": { "minAccuracy": 0.8, "minItems": 5, "atLevel": 2 },
      "followUp": "skip-counting",
