        "example": "7 is prime (1 × 7 only). 9 is not prime (1 × 9 and 3 × 3)."
      },
      "misconceptions": [
        { "code": "FACTOR_MULTIPLE_SWAP", "description": "Mixes up factors and multiples.", "remedy": "Factors fit INTO the number (smaller or equal). Multiples are the times table (equal or bigger)." },
        { "code": "ONE_IS_PRIME", "description": "Thinks 1 is a prime number.", "remedy": "A prime has exactly two different factors. 1 has only one factor." },
        { "code": "ODD_IS_PRIME", "description": "Thinks all odd numbers are prime (e.g. 9, 15).", "remedy": "Check for factors other than 1 and itself: 9 = 3 × 3." }
      ],
      "mastery": { "minAccuracy": 0.8, "minItems": 6, "atLevel": 2 },
