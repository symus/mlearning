          { "id": "fa2", "type": "choice", "prompt": "Which is a multiple of 5?", "options": [{ "id": "35", "label": "35" }, { "id": "52", "label": "52" }, { "id": "1", "label": "1" }], "answer": "35",
            "hints": ["Multiples of 5 end in 0 or 5.", "5 × 7"], "explanation": "35 = 5 × 7, so it's a multiple of 5.",
