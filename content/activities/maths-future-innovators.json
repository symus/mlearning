{
  "activities": [
    {
      "slug": "equivalent-fractions",
      "ageBand": "FUTURE_INNOVATORS", "subject": "maths", "topic": "Fractions", "subtopic": "Equivalent fractions",
      "objective": "MA.FRAC.EQUIV", "title": "Same Amount, Different Names", "pathOrder": 1, "estimatedMinutes": 7, "isFree": true,
      "learn": {
        "text": "Equivalent fractions show the same amount. If you cut each piece of 1/2 into 2 smaller pieces, you get 2/4 — the same amount of the bar. Multiply (or divide) the top and bottom by the same number to find equivalent fractions.",
        "visual": { "kind": "fractionBar", "parts": 4, "shaded": 2 },
        "example": "1/2 = 2/4 = 3/6 = 4/8 (×2, ×3, ×4 on top and bottom)"
      },
      "misconceptions": [
        { "code": "ADD_SAME", "description": "Adds the same number to top and bottom (1/2 → 2/3).", "remedy": "Adding changes the amount. Multiply top and bottom by the same number instead." },
        { "code": "ONLY_ONE_PART", "description": "Changes only the numerator or only the denominator.", "remedy": "Whatever you do to the bottom, do to the top." },
        { "code": "BIGGER_NUMBERS_BIGGER", "description": "Thinks a fraction with bigger numbers is a bigger amount.", "remedy": "Compare the shaded part of the bars: same shading = same amount." }
      ],
      "mastery": { "minAccuracy": 0.8, "minItems": 6, "atLevel": 2 },
      "followUp": "comparing-fractions",
      "levels": [
        { "level": 1, "label": "Warm-up", "items": [
          { "id": "ef1", "type": "choice", "prompt": "The bar shows 2/4. Which fraction is the same amount?", "visual": { "kind": "fractionBar", "parts": 4, "shaded": 2 },
            "options": [{ "id": "12", "label": "1/2" }, { "id": "13", "label": "1/3" }, { "id": "24", "label": "2/3" }], "answer": "12",
            "hints": ["How much of the bar is shaded?", "Half the bar is shaded."], "explanation": "2 out of 4 equal parts is half the bar: 2/4 = 1/2.",
            "misconceptions": { "13": "BIGGER_NUMBERS_BIGGER", "24": "ADD_SAME" } },
          { "id": "ef2", "type": "number", "prompt": "1/3 = ?/6", "visual": { "kind": "fractionBar", "parts": 6, "shaded": 2 }, "answer": 2,
            "hints": ["3 × 2 = 6 on the bottom.", "Do the same to the top: 1 × 2."], "explanation": "Multiply top and bottom by 2: 1/3 = 2/6.",
            "misconceptions": { "4": "ADD_SAME", "1": "ONLY_ONE_PART" } }
        ]},
        { "level": 2, "label": "Explorer", "items": [
          { "id": "ef3", "type": "number", "prompt": "3/4 = ?/12", "answer": 9,
            "hints": ["What do you multiply 4 by to get 12?", "4 × 3 = 12, so multiply the top by 3."], "explanation": "4 × 3 = 12 and 3 × 3 = 9, so 3/4 = 9/12.",
            "misconceptions": { "11": "ADD_SAME", "3": "ONLY_ONE_PART" } },
          { "id": "ef4", "type": "choice", "prompt": "Which fraction is NOT equivalent to 1/2?",
            "options": [{ "id": "a", "label": "5/10" }, { "id": "b", "label": "4/8" }, { "id": "c", "label": "3/5" }, { "id": "d", "label": "6/12" }], "answer": "c",
            "hints": ["For a half, the top is half of the bottom.", "Is 3 half of 5?"], "explanation": "3/5 is more than a half (half of 5 is 2.5). The others all equal 1/2.",
            "misconceptions": { "a": "BIGGER_NUMBERS_BIGGER", "b": "BIGGER_NUMBERS_BIGGER", "d": "BIGGER_NUMBERS_BIGGER" } },
          { "id": "ef5", "type": "number", "prompt": "Simplify 8/10 = 4/?", "answer": 5,
            "hints": ["8 ÷ 2 = 4.", "Divide the bottom by 2 as well."], "explanation": "Divide top and bottom by 2: 8/10 = 4/5.",
            "misconceptions": { "6": "ADD_SAME", "10": "ONLY_ONE_PART" } }
        ]},
        { "level": 3, "label": "Challenge", "items": [
          { "id": "ef6", "type": "number", "prompt": "Write 12/18 in its simplest form: 2/?", "answer": 3,
            "hints": ["Find the biggest number that divides 12 and 18.", "Both are in the 6 times table."], "explanation": "Divide top and bottom by 6: 12/18 = 2/3.",
            "misconceptions": { "8": "ADD_SAME", "9": "ONLY_ONE_PART" } },
          { "id": "ef7", "type": "choice", "prompt": "Nina ate 2/8 of a pizza. Oskar ate 1/4 of the same-sized pizza. Who ate more?",
            "options": [{ "id": "same", "label": "They ate the same" }, { "id": "nina", "label": "Nina" }, { "id": "oskar", "label": "Oskar" }], "answer": "same",
            "hints": ["Make the denominators the same.", "1/4 = ?/8"], "explanation": "1/4 = 2/8, so they ate exactly the same amount.",
            "misconceptions": { "nina": "BIGGER_NUMBERS_BIGGER" } }
        ]}
      ]
    },
    {
      "slug": "comparing-fractions",
      "ageBand": "FUTURE_INNOVATORS", "subject": "maths", "topic": "Fractions", "subtopic": "Comparing fractions",
      "objective": "MA.FRAC.COMPARE", "title": "Bigger Piece, Smaller Piece", "pathOrder": 2, "estimatedMinutes": 7,
      "learn": {
        "text": "With the same denominator, compare the numerators: 5/8 > 3/8. With the same numerator, the smaller denominator wins, because the whole is cut into fewer, bigger pieces: 1/3 > 1/5.",
        "visual": { "kind": "fractionBar", "parts": 3, "shaded": 1 },
        "example": "1/3 of a cake is bigger than 1/5 of the same cake."
      },
      "misconceptions": [
        { "code": "BIGGER_DENOMINATOR_BIGGER", "description": "Thinks 1/8 > 1/4 because 8 > 4.", "remedy": "More pieces means each piece is smaller. Picture sharing a cake with 8 people versus 4." },
        { "code": "IGNORE_DENOMINATOR", "description": "Compares numerators only, even when denominators differ.", "remedy": "Change to a common denominator before comparing numerators." }
      ],
      "mastery": { "minAccuracy": 0.8, "minItems": 6, "atLevel": 2 },
      "followUp": "decimal-detectives",
      "levels": [
        { "level": 1, "label": "Warm-up", "items": [
          { "id": "cf1", "type": "choice", "prompt": "Which is bigger?", "options": [{ "id": "a", "label": "5/8" }, { "id": "b", "label": "3/8" }], "answer": "a",
            "hints": ["The pieces are the same size (eighths).", "Which has more pieces?"], "explanation": "Both are eighths. 5 eighths is more than 3 eighths." },
          { "id": "cf2", "type": "choice", "prompt": "Which is bigger?", "options": [{ "id": "a", "label": "1/4" }, { "id": "b", "label": "1/8" }], "answer": "a",
            "hints": ["Imagine one pizza cut into 4 and another into 8.", "Which slice is bigger?"], "explanation": "Cutting into 4 makes bigger pieces than cutting into 8. 1/4 > 1/8.",
            "misconceptions": { "b": "BIGGER_DENOMINATOR_BIGGER" } }
        ]},
        { "level": 2, "label": "Explorer", "items": [
          { "id": "cf3", "type": "order", "prompt": "Order from smallest to largest.",
            "tiles": [{ "id": "12", "label": "1/2" }, { "id": "110", "label": "1/10" }, { "id": "15", "label": "1/5" }], "answer": ["110", "15", "12"],
            "hints": ["All have 1 on top.", "The bigger the bottom number, the smaller the piece."], "explanation": "1/10 < 1/5 < 1/2. Tenths are the smallest pieces." },
          { "id": "cf4", "type": "choice", "prompt": "Which is bigger: 2/3 or 3/6?",
            "options": [{ "id": "a", "label": "2/3" }, { "id": "b", "label": "3/6" }, { "id": "c", "label": "They are equal" }], "answer": "a",
            "hints": ["Change 2/3 into sixths.", "2/3 = 4/6"], "explanation": "2/3 = 4/6, and 4/6 > 3/6.",
            "misconceptions": { "b": "IGNORE_DENOMINATOR", "c": "IGNORE_DENOMINATOR" } }
        ]},
        { "level": 3, "label": "Challenge", "items": [
          { "id": "cf5", "type": "choice", "prompt": "Which is closest to 1 whole?",
            "options": [{ "id": "a", "label": "7/8" }, { "id": "b", "label": "3/4" }, { "id": "c", "label": "5/6" }], "answer": "a",
            "hints": ["How far is each from 1?", "7/8 is 1/8 away; 3/4 is 1/4 away; 5/6 is 1/6 away."], "explanation": "7/8 is only 1/8 away from 1, and 1/8 is the smallest gap.",
            "misconceptions": { "b": "IGNORE_DENOMINATOR", "c": "BIGGER_DENOMINATOR_BIGGER" } },
          { "id": "cf6", "type": "choice", "prompt": "Jas ran 3/5 of a track. Ewa ran 7/10 of it. Who ran further?",
            "options": [{ "id": "ewa", "label": "Ewa" }, { "id": "jas", "label": "Jas" }, { "id": "same", "label": "Same distance" }], "answer": "ewa",
            "hints": ["Change fifths into tenths.", "3/5 = 6/10"], "explanation": "3/5 = 6/10, and 7/10 > 6/10, so Ewa ran further.",
            "misconceptions": { "jas": "BIGGER_DENOMINATOR_BIGGER", "same": "IGNORE_DENOMINATOR" } }
        ]}
      ]
    },
    {
      "slug": "decimal-detectives",
      "ageBand": "FUTURE_INNOVATORS", "subject": "maths", "topic": "Decimals", "subtopic": "Place value",
      "objective": "MA.DEC.PV", "title": "Decimal Detectives", "pathOrder": 3, "estimatedMinutes": 7,
      "learn": {
        "text": "The decimal point separates whole numbers from parts. The first digit after the point is tenths, the second is hundredths. 0.7 = 7/10. 0.25 = 25/100. 0.5 is bigger than 0.45, because 5 tenths is more than 4 tenths.",
        "visual": { "kind": "fractionBar", "parts": 10, "shaded": 7 },
        "example": "3.42 = 3 ones + 4 tenths + 2 hundredths"
      },
      "misconceptions": [
        { "code": "LONGER_IS_BIGGER", "description": "Thinks a decimal with more digits is bigger (0.45 > 0.5).", "remedy": "Compare tenths first. Write 0.5 as 0.50 to compare fairly." },
        { "code": "PLACE_CONFUSION", "description": "Mixes up tenths and hundredths.", "remedy": "Tenths come straight after the point, hundredths next." }
      ],
      "mastery": { "minAccuracy": 0.8, "minItems": 6, "atLevel": 2 },
      "followUp": "percent-power",
      "levels": [
        { "level": 1, "label": "Warm-up", "items": [
          { "id": "dc1", "type": "number", "prompt": "Write 7/10 as a decimal.", "visual": { "kind": "fractionBar", "parts": 10, "shaded": 7 }, "answer": 0.7,
            "hints": ["Tenths go straight after the point.", "0.?"], "explanation": "7 tenths = 0.7.",
            "misconceptions": { "0.07": "PLACE_CONFUSION", "7": "PLACE_CONFUSION" } },
          { "id": "dc2", "type": "choice", "prompt": "What is the value of the 4 in 2.48?",
            "options": [{ "id": "t", "label": "4 tenths" }, { "id": "h", "label": "4 hundredths" }, { "id": "o", "label": "4 ones" }], "answer": "t",
            "hints": ["Which place comes straight after the point?", "First after the point is tenths."], "explanation": "The 4 is straight after the point, so it means 4 tenths (0.4).",
            "misconceptions": { "h": "PLACE_CONFUSION", "o": "PLACE_CONFUSION" } }
        ]},
        { "level": 2, "label": "Explorer", "items": [
          { "id": "dc3", "type": "choice", "prompt": "Which is bigger?", "options": [{ "id": "a", "label": "0.5" }, { "id": "b", "label": "0.45" }], "answer": "a",
            "hints": ["Compare the tenths digit first.", "0.5 = 0.50"], "explanation": "0.50 > 0.45 because 5 tenths > 4 tenths.",
            "misconceptions": { "b": "LONGER_IS_BIGGER" } },
          { "id": "dc4", "type": "number", "prompt": "Write 35/100 as a decimal.", "answer": 0.35,
            "hints": ["Hundredths need two digits after the point.", "0.??"], "explanation": "35 hundredths = 0.35.",
            "misconceptions": { "3.5": "PLACE_CONFUSION", "0.035": "PLACE_CONFUSION" } }
        ]},
        { "level": 3, "label": "Challenge", "items": [
          { "id": "dc5", "type": "order", "prompt": "Order from smallest to largest.",
            "tiles": [{ "id": "a", "label": "0.6" }, { "id": "b", "label": "0.09" }, { "id": "c", "label": "0.35" }, { "id": "d", "label": "0.351" }],
            "answer": ["b", "c", "d", "a"], "hints": ["Compare tenths first: 0, 3, 3, 6.", "0.35 vs 0.351: add a zero to compare."],
            "explanation": "0.09 < 0.35 < 0.351 < 0.6. Length doesn't decide size; place value does." },
          { "id": "dc6", "type": "number", "prompt": "A runner's time is 12.4 seconds. The next runner is 0.15 seconds slower. What is their time?", "answer": 12.55,
            "hints": ["12.4 = 12.40", "12.40 + 0.15"], "explanation": "12.40 + 0.15 = 12.55 seconds.",
            "misconceptions": { "12.19": "PLACE_CONFUSION", "13.9": "PLACE_CONFUSION" } }
        ]}
      ]
    },
    {
      "slug": "percent-power",
