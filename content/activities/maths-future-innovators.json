        { "code": "TWO_SIDES_ONLY", "description": "Adds only two sides for perimeter.", "remedy": "A rectangle has 4 sides. Add length + width, then double it." }
      ],
      "mastery": { "minAccuracy": 0.8, "minItems": 6, "atLevel": 2 },
      "followUp": "factor-finders",
