        { "code": "DIVIDE_BY_PERCENT", "description": "Divides by the percentage number (20% of 50 → 50 ÷ 20).", "remedy": "Find 10% first by dividing by 10, then scale up." }
      ],
      "mastery": { "minAccuracy": 0.8, "minItems": 6, "atLevel": 2 },
      "followUp": "area-and-perimeter",
